# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subscribeiq
DB_USER=postgres
DB_PASSWORD=your_password_here

# Least-privilege role for the dashboard and Ask SubscribeIQ (SELECT on the five tables only,
# read-only by default). Pick a password, then run: python database/create_readonly_role.py
DB_READONLY_USER=subscribeiq_reader
DB_READONLY_PASSWORD=choose_a_different_password

# Google Gemini (required from Phase 8 onward)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: pin a model (default gemini-3.5-flash, falling back to gemini-flash-latest)
# GEMINI_MODEL=gemini-3.5-flash
